{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "DOMAIN_NAME",
        "DATABASE_URL",
        "DATABASE_ADAPTER",

        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "BASE_URL",
        "REGISTRATION_ENABLED",
        "EMAIL_VERIFICATION_REQUIRED",

        "NEXT_PUBLIC_STRIPE_PUBLIC_KEY",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SIGNING_SECRET",
        "STRIPE_DEFAULT_TAX_RATE_ID",
        "PRO_MONTHLY_PRICE_ID",
        "PRO_YEARLY_PRICE_ID",
        "AGENCY_MONTHLY_PRICE_ID",
        "AGENCY_YEARLY_PRICE_ID",

        "PLUNK_SECRET_KEY",
        "RESEND_API_KEY",
        "RESEND_SEGMENT_ID",
        "MAILER_PROVIDER",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_SECURE",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "SMTP_FROM",

        "STORAGE_REGION",
        "STORAGE_BUCKET_NAME",
        "STORAGE_PROVIDER",
        "STORAGE_ENDPOINT",
        "STORAGE_FORCE_PATH_STYLE",
        "NEXT_PUBLIC_STORAGE_BASE_URL",
        "R2_ACCOUNT_ID",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_REGION",

        "NEXT_PUBLIC_FF_API_ORIGIN",
        "NEXT_PUBLIC_IS_CLOUD",

        "INNGEST_EVENT_KEY",
        "INNGEST_SIGNING_KEY",
        "INNGEST_BASE_URL",
        "INNGEST_DEV",

        "GITHUB_APP_ID",
        "GITHUB_APP_NAME",
        "GITHUB_PRIVATE_KEY",
        "GITHUB_WEBHOOK_SECRET",

        "LINEAR_CLIENT_ID",
        "LINEAR_CLIENT_SECRET",
        "LINEAR_OAUTH_REDIRECT_URI",
        "LINEAR_WEBHOOK_SIGNING_SECRET",
        "LINEAR_TOKEN_ENCRYPTION_KEY",

        "JIRA_CLIENT_ID",
        "JIRA_CLIENT_SECRET",
        "JIRA_OAUTH_REDIRECT_URI",
        "JIRA_TOKEN_ENCRYPTION_KEY",
        "JIRA_WEBHOOK_BASE_URL",

        "SLACK_CLIENT_ID",
        "SLACK_CLIENT_SECRET",
        "SLACK_TOKEN_ENCRYPTION_KEY"
      ]
    }
  }
}
