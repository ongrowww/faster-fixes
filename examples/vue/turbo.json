{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["NEXT_PUBLIC_FF_API_KEY", "NEXT_PUBLIC_FF_API_ORIGIN"],
      "outputs": ["dist/**"]
    },
    "dev": {
      // The example resolves `@fasterfixes/vue` from its build output.
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_FF_API_KEY", "NEXT_PUBLIC_FF_API_ORIGIN"]
    }
  }
}
