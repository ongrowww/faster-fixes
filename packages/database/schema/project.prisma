model Project {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name           String
  domain         String @map("url")
  publicId       String @unique
  apiKeyHash     String
  apiKeyLastFour String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  widgetConfig WidgetConfig?
  reviewers    Reviewer[]
  feedback     Feedback[]
  reviewImages ReviewImage[]
  gitHubLink   ProjectGitHubLink?
  linearLink   ProjectLinearLink?
  jiraLink     ProjectJiraLink?
  slackLink    ProjectSlackLink?

  @@index([organizationId])
  @@index([publicId])
  @@map("project")
}

model WidgetConfig {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  enabled Boolean @default(true)

  @@map("widget_config")
}

model Reviewer {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name     String
  token    String  @unique
  isActive Boolean @default(true)

  feedback     Feedback[]
  reviewImages ReviewImage[]

  @@index([projectId])
  @@map("reviewer")
}

model Feedback {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   Reviewer @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  status  String @default("new")
  comment String
  pageUrl String

  clickX   Float?
  clickY   Float?
  selector String?

  browserName    String?
  browserVersion String?
  os             String?
  viewportWidth  Int?
  viewportHeight Int?

  metadata Json?

  // Diagnostic Trail: console + network snapshot captured by the widget at
  // submission. Read lazily by the dashboard modal only; never selected on
  // the widget read path (kept out of the hot getFeedback query).
  diagnosticTrail Json?

  screenshotId String?
  screenshot   Asset?  @relation("FeedbackScreenshot", fields: [screenshotId], references: [id], onDelete: SetNull)

  reviewImageId String?
  reviewImage   ReviewImage? @relation(fields: [reviewImageId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   Member? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  issueLink       FeedbackIssueLink?
  linearIssueLink FeedbackLinearIssueLink?
  jiraIssueLink   FeedbackJiraIssueLink?
  slackMessage    FeedbackSlackMessage?

  @@index([projectId])
  @@index([reviewerId])
  @@index([assigneeId])
  @@index([reviewImageId])
  @@map("feedback")
}

model ReviewImage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publicId String @unique

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assetId String @unique
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  uploadedByReviewerId String?
  uploadedByReviewer   Reviewer? @relation(fields: [uploadedByReviewerId], references: [id], onDelete: SetNull)

  archivedAt DateTime?
  feedback   Feedback[]

  @@index([projectId, archivedAt])
  @@index([uploadedByReviewerId])
  @@map("review_image")
}
