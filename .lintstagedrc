{
  "*": "prettier --ignore-unknown --write",
  "apps/web/**/*.{ts,tsx,js,jsx}": "pnpm --filter web exec eslint --max-warnings 0",
  "packages/ui/**/*.{ts,tsx,js,jsx}": "pnpm --filter @workspace/ui exec eslint --max-warnings 0",
  "packages/mcp/**/*.{ts,tsx,js,jsx}": "pnpm --filter @fasterfixes/mcp exec eslint --max-warnings 0",
  "packages/widget/**/*.{ts,tsx,js,jsx}": "pnpm --filter @fasterfixes/widget exec eslint --max-warnings 0",
  "packages/widget-core/**/*.{ts,tsx,js,jsx}": "pnpm --filter @fasterfixes/core exec eslint --max-warnings 0",
  "packages/widget-react/**/*.{ts,tsx,js,jsx}": "pnpm --filter @fasterfixes/react exec eslint --max-warnings 0",
  "packages/widget-vue/**/*.{ts,tsx,js,jsx}": "pnpm --filter @fasterfixes/vue exec eslint --max-warnings 0",
  "packages/widget-angular/**/*.{ts,tsx,js,jsx}": "pnpm --filter @fasterfixes/angular exec eslint --max-warnings 0",
  "packages/widget-svelte/**/*.{ts,tsx,js,jsx}": "pnpm --filter @fasterfixes/svelte exec eslint --max-warnings 0",
  "examples/vue/**/*.{ts,tsx,js,jsx}": "pnpm --filter @workspace/example-vue exec eslint --max-warnings 0",
  "examples/angular/**/*.{ts,tsx,js,jsx,mjs}": "pnpm --filter @workspace/example-angular exec eslint --max-warnings 0",
  "examples/svelte/**/*.{ts,tsx,js,jsx}": "pnpm --filter @workspace/example-svelte exec eslint --max-warnings 0"
}
